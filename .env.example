# DeepSeek API Key（必填，到 https://platform.deepseek.com 申请）
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxx

# 模型名（可选，默认 deepseek-v4-flash；质量更高可选 deepseek-v4-pro）
DEEPSEEK_MODEL=deepseek-v4-flash

# 是否关闭思考模式（可选，默认 true=关闭，更快更省且 temperature 才生效）
DEEPSEEK_THINKING=false

# ---- ntfy 手机推送（可选，用于定时把结果推到手机）----
# ntfy 服务器（默认公共服务器 https://ntfy.sh）
#NTFY_SERVER=https://ntfy.sh
# 已存在的订阅 topic（手机 ntfy 应用需已订阅）
#NTFY_TOPIC=zhenghz-sport

# ---- RSS 源覆盖（可选）----
# 用 .env 覆盖 config.py 里的默认 RSS 源（大陆服务器上默认海外源可能不可达时用）。
# 格式：名字|url,名字|url（逗号分隔多个源）
#RSS_FEEDS=ESPN|https://www.espn.com/espn/rss/news,网易体育|https://sports.163.com/special/00051K8P/rss_newstop.xml
